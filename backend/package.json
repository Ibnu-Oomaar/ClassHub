{
  "name": "classhub-backend",
  "version": "1.0.0",
  "description": "CLASSHUB API for the 3C Morning Boys class (NestJS + TypeORM + PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "bun dist/src/main.js",
    "seed:class-master": "bun run build && node dist/src/database/seed-class-master.js",
    "seed:students": "bun run build && node dist/src/database/seed-students.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/passport": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
